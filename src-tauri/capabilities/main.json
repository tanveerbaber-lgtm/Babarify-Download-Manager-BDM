{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Least-privilege capability for the main window: listening to BDM's own events, closing and titling its own windows, a file/folder picker, and BDM's own commands. No window, webview, path, menu, tray, filesystem, shell, HTTP, opener or notification APIs are granted to the webview; files are opened and notifications shown by the Rust side only.",
  "windows": [
    "main",
    "download-*"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "core:window:allow-set-title",
    "dialog:allow-open",
    "allow-get-app-info",
    "allow-list-downloads",
    "allow-add-download",
    "allow-resume-download",
    "allow-pause-download",
    "allow-cancel-download",
    "allow-remove-download",
    "allow-suggest-file-name",
    "allow-get-settings",
    "allow-update-settings",
    "allow-get-media-tools",
    "allow-install-media-tools",
    "allow-check-media-tool-updates",
    "allow-analyze-media",
    "allow-add-media-downloads",
    "allow-get-browser-integration",
    "allow-register-browser-integration",
    "allow-unregister-browser-integration",
    "allow-add-batch",
    "allow-expand-batch-pattern",
    "allow-import-url-list",
    "allow-find-duplicate",
    "allow-list-queues",
    "allow-save-queue",
    "allow-delete-queue",
    "allow-start-queue",
    "allow-stop-queue",
    "allow-list-categories",
    "allow-save-category",
    "allow-delete-category",
    "allow-set-download-priority",
    "allow-move-downloads-to-queue",
    "allow-move-downloads-in-queue",
    "allow-set-download-speed-limit",
    "allow-redownload",
    "allow-clear-finished",
    "allow-open-download",
    "allow-show-in-folder",
    "allow-file-sha256",
    "allow-bulk-action",
    "allow-open-download-window",
    "allow-open-legal-document",
    "allow-refresh-download-link"
  ]
}
