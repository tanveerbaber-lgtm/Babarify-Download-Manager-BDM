{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Babarify Download Manager",
  "mainBinaryName": "bdm",
  "version": "0.1.0",
  "identifier": "com.babarify.bdm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Babarify Download Manager",
        "width": 1200,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Babarify",
    "copyright": "© 2026 Babarify",
    "category": "Utility",
    "shortDescription": "Babarify Download Manager",
    "longDescription": "A fast, reliable download manager for Windows.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
