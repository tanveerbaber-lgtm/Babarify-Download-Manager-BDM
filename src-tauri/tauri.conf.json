{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Babarify Download Manager",
  "mainBinaryName": "bdm",
  "version": "1.0.0",
  "identifier": "com.babarify.bdm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && node scripts/prepare-sidecar.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Babarify Download Manager",
        "width": 1180,
        "height": 740,
        "minWidth": 820,
        "minHeight": 520,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Babarify",
    "copyright": "© 2026 Babarify. All rights reserved.",
    "category": "Utility",
    "shortDescription": "Babarify Download Manager",
    "longDescription": "Faster Downloads. More Possibilities. A fast, reliable download manager for Windows with browser integration, video and audio downloads, queues and schedules.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/bdm-native-host"
    ],
    "homepage": "https://github.com/tanveerbaber-lgtm/Babarify-Download-Manager-BDM",
    "license": "LicenseRef-Proprietary",
    "licenseFile": "../LICENSE.txt",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "installerHooks": "installer-hooks.nsh",
        "startMenuFolder": "Babarify Download Manager"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "resources": {
      "../LICENSE.txt": "legal/LICENSE.txt",
      "../PRIVACY.md": "legal/PRIVACY.md",
      "../THIRD_PARTY_NOTICES.txt": "legal/THIRD_PARTY_NOTICES.txt"
    }
  }
}
