{
  "manifest_version": 3,
  "name": "Babarify Download Manager",
  "short_name": "BDM",
  "version": "1.0.0",
  "description": "Send downloads, links and videos to Babarify Download Manager. Faster Downloads. More Possibilities.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Babarify Download Manager",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "downloads",
    "contextMenus",
    "nativeMessaging",
    "storage",
    "activeTab"
  ],
  "optional_permissions": [
    "webRequest",
    "scripting",
    "cookies"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
